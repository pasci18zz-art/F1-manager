<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/glass" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:visibility="gone"/>
<LinearLayout android:id="@+id/panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg_dark" android:padding="14dp">
  <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#A9AEBD" android:fontFamily="sans-serif-condensed" android:maxLines="3" android:ellipsize="end" android:text="Öffne die App einmal, dann erscheint hier die Wertung." android:visibility="gone"/>
  <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal">
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
        <FrameLayout android:layout_width="wrap_content" android:layout_height="24dp" android:minWidth="30dp">
        <ImageView android:id="@+id/b2_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_badge" android:scaleType="fitXY"/>
        <TextView android:id="@+id/b2_num" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:paddingStart="5dp" android:paddingEnd="5dp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:textSize="14sp" android:textColor="#FFFFFF" android:text="–"/>
      </FrameLayout>
        <TextView android:id="@+id/name2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#F2F3F7" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Fahrer" android:gravity="center"/>
        <TextView android:id="@+id/pts2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#F2F3F7" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="0" android:gravity="center"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_marginTop="3dp">
          <ImageView android:id="@+id/step2" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_step" android:scaleType="fitXY"/>
          <TextView android:id="@+id/pos2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#FFC93C" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="2" android:layout_gravity="top|center_horizontal" android:paddingTop="2dp"/>
        </FrameLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
        <FrameLayout android:layout_width="wrap_content" android:layout_height="24dp" android:minWidth="30dp">
        <ImageView android:id="@+id/b1_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_badge" android:scaleType="fitXY"/>
        <TextView android:id="@+id/b1_num" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:paddingStart="5dp" android:paddingEnd="5dp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:textSize="14sp" android:textColor="#FFFFFF" android:text="–"/>
      </FrameLayout>
        <TextView android:id="@+id/name1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#F2F3F7" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Fahrer" android:gravity="center"/>
        <TextView android:id="@+id/pts1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#F2F3F7" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="0" android:gravity="center"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_marginTop="3dp">
          <ImageView android:id="@+id/step1" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_step" android:scaleType="fitXY"/>
          <TextView android:id="@+id/pos1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#FFC93C" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="1" android:layout_gravity="top|center_horizontal" android:paddingTop="2dp"/>
        </FrameLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="bottom|center_horizontal">
        <FrameLayout android:layout_width="wrap_content" android:layout_height="24dp" android:minWidth="30dp">
        <ImageView android:id="@+id/b3_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_badge" android:scaleType="fitXY"/>
        <TextView android:id="@+id/b3_num" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:paddingStart="5dp" android:paddingEnd="5dp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:textSize="14sp" android:textColor="#FFFFFF" android:text="–"/>
      </FrameLayout>
        <TextView android:id="@+id/name3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#F2F3F7" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Fahrer" android:gravity="center"/>
        <TextView android:id="@+id/pts3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#F2F3F7" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="0" android:gravity="center"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_marginTop="3dp">
          <ImageView android:id="@+id/step3" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_step" android:scaleType="fitXY"/>
          <TextView android:id="@+id/pos3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#FFC93C" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="3" android:layout_gravity="top|center_horizontal" android:paddingTop="2dp"/>
        </FrameLayout>
      </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/divider" android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:src="@drawable/widget_strip" android:scaleType="fitXY" android:alpha="0.15"/>
    <LinearLayout android:layout_width="112dp" android:layout_height="match_parent" android:orientation="vertical">
      <TextView android:id="@+id/lbl_gap" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#A9AEBD" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Vorsprung" android:textAllCaps="true" android:letterSpacing="0.06"/>
      <TextView android:id="@+id/gap" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="28sp" android:textColor="#2FD47A" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="–"/>
      <TextView android:id="@+id/gap_who" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#A9AEBD" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:text=""/>
      <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
      <TextView android:id="@+id/lbl_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#A9AEBD" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Nächstes Rennen" android:textAllCaps="true" android:letterSpacing="0.06"/>
      <TextView android:id="@+id/next" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#F2F3F7" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="–" android:textAllCaps="true"/>
      <TextView android:id="@+id/round" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#A9AEBD" android:fontFamily="sans-serif-condensed" android:maxLines="1" android:ellipsize="end" android:text=""/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
</FrameLayout>
